# ─── CaseBuddy Environment Variables ───────────────────────────────
# Copy this file to .env.local and fill in values for local development.
# Do NOT commit .env.local, production credentials, or provider keys.
#
# RULE: VITE_* values are browser-readable. Only public configuration belongs
# under VITE_*. Permanent API keys and secrets must use server-only variables.

# ── Public browser configuration ──
VITE_FIRM_ID=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=

# ── Supabase server configuration ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-only fallback for the generic /intake route. Firm-specific
# links remain preferred because the opaque referral token is authoritative.
# If omitted, server code falls back to VITE_FIRM_ID; if neither is present,
# generic anonymous intake is accepted only when exactly one firm exists.
CASEBUDDY_CANONICAL_FIRM_ID=

# ── Internal pipeline authentication ──
# Generate high-entropy values independently of every provider/service-role key.
PIPELINE_WORKER_SECRET=
# Optional separate caller secret for the orchestrator. If omitted, the checked-in
# function falls back to PIPELINE_WORKER_SECRET for backwards-compatible setup.
PIPELINE_ORCHESTRATOR_SECRET=

# ── AI / voice providers — server-side only ──
GEMINI_API_KEY=
# Realtime Live Voice engine: 3.1 Flash Live Preview primary with 2.5 Native Audio fallback
GEMINI_LIVE_MODEL=models/gemini-3.1-flash-live-preview
GEMINI_LIVE_FALLBACK_MODEL=models/gemini-2.5-flash-native-audio-preview-09-2025
GEMINI_LIVE_VOICE=Aoede
DEEPGRAM_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ELEVENLABS_API_KEY=

# ── OCR / research providers — server-side only ──
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=
COURTLISTENER_API_KEY=

# ── Email & SMS — server-side only ──
SENDGRID_API_KEY=
RESEND_API_KEY=
FIRM_OWNER_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FIRM_OWNER_PHONE=

# ── Scheduled jobs / integrations ──
# Vercel Cron sends Authorization: Bearer $CRON_SECRET. This also authorizes
# the daily private-intake recording retention purge.
CRON_SECRET=
GITHUB_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── CORS ──
# Comma-separated exact origins accepted by credential/proxy endpoints.
ALLOWED_ORIGIN=https://casebuddy.live
