{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "types": ["node"],
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowImportingTsExtensions": false,
    "esModuleInterop": true,
    "noEmit": true,
    "strict": false
  },
  "include": ["server/**/*.ts", "api/**/*.ts"]
}
